{
  "name": "@smallpict/sdk",
  "version": "1.0.0-alpha.1",
  "description": "Official TypeScript & Node.js SDK for SmallPict Image Optimization API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "lint": "eslint src/**",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "smallpict",
    "image-optimization",
    "webp",
    "avif",
    "image-compression",
    "cdn"
  ],
  "author": "SmallPict Engineering <support@tuxnoob.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuxnoob/smallpict-node.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
