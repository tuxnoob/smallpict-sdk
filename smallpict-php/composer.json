{
  "name": "smallpict/smallpict-php",
  "description": "Official PHP SDK for SmallPict Image Optimization API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "SmallPict Engineering",
      "email": "support@tuxnoob.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "SmallPict\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SmallPict\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SmallPict\\Laravel\\SmallPictServiceProvider"
      ],
      "aliases": {
        "SmallPict": "SmallPict\\Laravel\\Facades\\SmallPict"
      }
    }
  }
}
